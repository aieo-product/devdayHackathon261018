# 必須: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" で生成
FOCUS_API_TOKEN=
# 実API検証時にサーバーだけへ設定。フロント/機器には配布しない
OPENAI_API_KEY=
DECISION_PROVIDER=openai
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# mock時だけ使用。実画像を判定せず、この固定値を返す
MOCK_PHONE_PROBABILITY=0
MOCK_OBSERVABLE_PROBABILITY=1
