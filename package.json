{
  "name": "focus-hackathon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start:api": "node --env-file-if-exists=api/.env api/src/index.mjs",
    "test": "node --test api/test/*.test.mjs clients/*.test.mjs",
    "smoke": "node --env-file-if-exists=api/.env scripts/smoke-test.mjs",
    "smoke:worker": "node --env-file-if-exists=cloudflare/.env.connection scripts/smoke-worker.mjs",
    "start:worker": "wrangler dev -c cloudflare/wrangler.jsonc",
    "deploy:worker": "wrangler deploy -c cloudflare/wrangler.jsonc",
    "check:worker": "wrangler deploy --dry-run -c cloudflare/wrangler.jsonc",
    "test:worker": "node --test cloudflare/test/*.test.mjs",
    "start:mac-check": "node --env-file-if-exists=cloudflare/.env.connection tools/mac-camera-check/server.mjs",
    "test:mac-check": "node --test tools/mac-camera-check/*.test.mjs",
    "test:events": "node --test cloudflare-events/test/*.test.mjs",
    "smoke:events": "node --env-file-if-exists=cloudflare/.env.connection scripts/smoke-events.mjs",
    "start:events": "wrangler dev -c cloudflare-events/wrangler.jsonc",
    "check:events": "wrangler deploy --dry-run -c cloudflare-events/wrangler.jsonc",
    "deploy:events": "wrangler deploy -c cloudflare-events/wrangler.jsonc",
    "start:front": "npm --prefix focus-dopa-preview start",
    "test:front": "npm --prefix focus-dopa-preview test",
    "build:web": "node cloudflare-web/scripts/build-assets.mjs",
    "start:web": "npm run build:web && wrangler dev -c cloudflare-web/wrangler.jsonc",
    "check:web": "npm run build:web && wrangler deploy --dry-run -c cloudflare-web/wrangler.jsonc",
    "deploy:web": "npm run build:web && wrangler deploy -c cloudflare-web/wrangler.jsonc",
    "test:web": "node --test cloudflare-web/test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1"
  }
}
